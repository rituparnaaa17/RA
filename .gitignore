# ── Node modules (anywhere) ───────────────────────────────────────────────────
node_modules/

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ── Backend (Python / FastAPI) ────────────────────────────────────────────────
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/venv/
backend/.venv/
backend/uploads/
backend/*.db

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
backend/.env
# Allow the example template to be committed
!backend/.env.example
# Aiven SSL certificate — contains credentials, never commit
backend/ca.pem
ca.pem

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.db
*.sqlite