# ── Database (Aiven MySQL) ─────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=
DB_PASSWORD=

# Path to Aiven CA certificate (download from Aiven console).
# On Render: upload as a Secret File and set this to the mount path.
# Leave blank to skip SSL (local dev only).
DB_SSL_CA=./ca.pem

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production:  https://srm-result-analysis.vercel.app
# Local dev:   http://localhost:3000
ALLOWED_ORIGINS=https://srm-result-analysis.vercel.app

# ── JWT secret ────────────────────────────────────────────────────────────────
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
ENV=production
